# Copy to .env and fill in:
#   cp .env.example .env
#
# Used by docker-compose.yml (gowa), the bridge and the admin UI.

# --- gowa (docker-compose.yml) ---
GOWA_PORT=3011
GOWA_BASIC_AUTH_USER=admin
GOWA_BASIC_AUTH_PASSWORD=changeme

# Shared between gowa (HMAC-signs webhook payloads) and the bridge (verifies
# them). Generate a real one with: openssl rand -hex 32
WEBHOOK_SECRET=changeme-generate-a-real-secret

# --- bridge (cmd/bridge) ---
LISTEN_ADDR=:8099
GOWA_BASE_URL=http://localhost:3011
# Same as GOWA_BASIC_AUTH_USER/PASSWORD above — the bridge authenticates to
# gowa's REST API with these too.
GOWA_BASIC_AUTH_USER=admin
GOWA_BASIC_AUTH_PASSWORD=changeme

# YOUR phone number — the one number allowed to instruct the bot in PERSONAL
# mode (the default). Required: the bridge refuses to start without it, so a
# fresh install can never be open to everybody. Use the SENDER's number, NOT
# the bot's own linked-device number (you write to the bot's number from your
# own phone). Format: <country code><number>@s.whatsapp.net or just the digits.
# Matching is EXACT — a shorter number never matches a longer one.
#
# Personal mode has exactly one number, so extra entries are ignored (with a
# warning in the log). This is only the starting point: once you save a policy
# in the Admin UI ("Who can instruct the bot") it is kept in ACCESS_FILE and
# this value is no longer used. TEAM mode (one WhatsApp group, approved members,
# @mention required) is configured only in the Admin UI.
ALLOWED_SENDERS=15551234567@s.whatsapp.net

# DEPRECATED — admits nobody any more (the bridge just warns if it is set).
# Groups are set up as team mode in the Admin UI.
# ALLOWED_GROUPS=

# Optional — sensible defaults if left unset:
#   ADMIN_ADDR          defaults to 127.0.0.1:8098 — the admin web UI
#                        (cmd/admin). Comma-separated host:port list. It can
#                        re-pair WhatsApp, so by default it is loopback-only
#                        (reach it via `ssh -L 8098:127.0.0.1:8098 <host>`).
#                        To serve it on a LAN/ZeroTier address, list that
#                        specific IP (0.0.0.0 is refused) AND set
#                        ADMIN_ALLOWED_NETS, e.g.
#                          ADMIN_ADDR=127.0.0.1:8098,192.168.1.20:8098
#                          ADMIN_ALLOWED_NETS=192.168.1.0/24
#                        A listed IP that doesn't exist yet (ZeroTier at boot)
#                        is retried every 5s.
#   ADMIN_ALLOWED_NETS  comma-separated CIDRs of clients allowed to connect
#                        (loopback is always allowed). Required whenever
#                        ADMIN_ADDR has a non-loopback address.
#   ADMIN_ALLOWED_HOSTS extra Host header names to accept (e.g. a DNS name);
#                        the ADMIN_ADDR hosts are accepted automatically.
#   ADMIN_AUTH_FILE    defaults to ~/.claude-whatsapp/admin.json — the admin
#                        page's login (username + password HASH, mode 0600).
#                        Create or reset it with `bin/admin passwd`; the
#                        installer asks for it, and it can also be created from
#                        the login page opened on the machine itself.
#   ADMIN_PASSWORD, ADMIN_USER
#                       LEGACY bootstrap only (v0.2.0 kept the password here):
#                        if no login file exists yet, this password is hashed
#                        into one on the first start (user ADMIN_USER, default
#                        "admin") and ignored afterwards — delete it from .env.
#   ACCESS_FILE         defaults to ~/.claude-whatsapp/access.json — the access
#                        policy (personal/team mode, approved members) written
#                        by the Admin UI and re-read by the bridge on change.
#                        A broken file makes the bridge deny everybody.
#   LOG_GROUP_MESSAGES  set to 1 to log sender, ids and text of group messages
#                        plus the decision taken — for diagnosing @mention
#                        detection. Off by default: it writes message text to
#                        the log.
#   CLAUDE_BIN          defaults to "claude" (resolved via PATH)
#   WORK_DIR            defaults to your $HOME — this is where `claude -p`
#                        runs, i.e. where it picks up your ~/CLAUDE.md
#   SESSION_STORE_PATH  defaults to ~/.claude-whatsapp/sessions.json
#   PENDING_DIR         defaults to ~/.claude-whatsapp/pending — durable
#                        queue for messages ack'd but not yet replied to
#   GOWA_MEDIA_DIR      defaults to ./data/statics — must match the host
#                        side of docker-compose.yml's "/app/statics" mount,
#                        so the bridge can read attachments gowa downloads
#   WHISPER_BIN         defaults to ./bin/whisper-cli — voice-note
#                        transcription (internal/transcribe). If this or
#                        WHISPER_MODEL doesn't exist at startup,
#                        transcription is silently disabled — voice notes
#                        fall back to "can't listen, please retype". Run
#                        scripts/setup-whisper.sh to install both.
#   WHISPER_MODEL       defaults to ./data/whisper/ggml-base.bin
#   FFMPEG_BIN          defaults to "ffmpeg" (resolved via PATH) — used to
#                        normalize voice notes (Opus-in-Ogg) to WAV first
#   WHISPER_LANG        defaults to "auto" (per-clip language detection);
#                        set to a fixed code (e.g. "id") to skip detection
